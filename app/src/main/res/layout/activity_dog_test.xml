<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".DogTestActivity">

    <TextView
        android:id="@+id/dogTestTextView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:background="#E0E0E0"
        android:gravity="center"
        android:padding="32dp"
        android:text="dog"
        android:textSize="48sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/nextTestButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/nextTestButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Next Test Text"
        android:contentDescription="Go to the next test text"
        android:textSize="18sp"
        app:layout_constraintTop_toBottomOf="@id/dogTestTextView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/resetTestButton"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/resetTestButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Reset to 'dog'"
        android:contentDescription="Reset the test text to 'dog'"
        android:textSize="18sp"
        app:layout_constraintTop_toBottomOf="@id/nextTestButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
